meta {
  name: Admin login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/admin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

docs {
  Autentica o administrador e grava o cookie HttpOnly wedding_session.
}
